{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "description": "OptiTalent paper-and-ink tokens. HR files on a desk, not generic purple SaaS.",
  "color": {
    "primitive": {
      "ink": { "$value": "#1A2E24" },
      "forest": { "$value": "#1F4D3A" },
      "moss": { "$value": "#3D6B54" },
      "paper": { "$value": "#F4EFE6" },
      "card": { "$value": "#FFFCF7" },
      "rule": { "$value": "#D9D0C3" },
      "stamp": { "$value": "#B5472A" }
    },
    "semantic": {
      "bg": { "$value": "{color.primitive.paper}" },
      "fg": { "$value": "{color.primitive.ink}" },
      "primary": { "$value": "{color.primitive.forest}" },
      "danger": { "$value": "{color.primitive.stamp}" }
    }
  },
  "font": {
    "display": { "$value": "Fraunces" },
    "body": { "$value": "Source Sans 3" },
    "mono": { "$value": "IBM Plex Mono" }
  },
  "space": {
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "16px" },
    "lg": { "$value": "24px" },
    "xl": { "$value": "40px" }
  },
  "radius": {
    "sm": { "$value": "2px" },
    "md": { "$value": "6px" }
  }
}
